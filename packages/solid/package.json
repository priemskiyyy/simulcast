{
  "name": "@priemskiyyy/simulcast-solid",
  "version": "0.1.0",
  "description": "Solid bindings for simulcast: a provider component that owns the realtime session and primitives for shared channel subscriptions, typed events, channel status, and connection state.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/simulcast.git",
    "directory": "packages/solid"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/simulcast/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project solid"
  },
  "peerDependencies": {
    "@priemskiyyy/simulcast": ">=0.1.0 <0.2",
    "solid-js": ">=1.8.0 <2"
  },
  "devDependencies": {
    "@priemskiyyy/simulcast": "workspace:*"
  },
  "keywords": [
    "solid",
    "solid-js",
    "primitives",
    "realtime",
    "real-time",
    "websocket",
    "pubsub",
    "subscriptions",
    "typed-events",
    "typescript",
    "ssr",
    "simulcast"
  ],
  "homepage": "https://priemskiyyy.github.io/simulcast/"
}
