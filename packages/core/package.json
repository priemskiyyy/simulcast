{
  "name": "@priemskiyyy/simulcast",
  "version": "0.1.0",
  "description": "Provider-independent realtime subscription runtime: connection sessions, shared channel subscriptions, consumer fan-out, and deterministic cleanup behind a small adapter contract.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/simulcast.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/simulcast/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project core"
  },
  "keywords": [
    "realtime",
    "real-time",
    "websocket",
    "pubsub",
    "subscriptions",
    "centrifugo",
    "pusher",
    "ably",
    "typescript",
    "simulcast",
    "react-native",
    "expo"
  ],
  "homepage": "https://priemskiyyy.github.io/simulcast/"
}
