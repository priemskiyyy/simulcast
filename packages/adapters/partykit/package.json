{
  "name": "@priemskiyyy/simulcast-partykit",
  "version": "0.3.0",
  "description": "PartyKit and PartyServer adapter for simulcast, built on partysocket.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/simulcast.git",
    "directory": "packages/adapters/partykit"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/simulcast/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project partykit"
  },
  "peerDependencies": {
    "partysocket": ">=1.0.0 <2",
    "@priemskiyyy/simulcast": ">=0.3.0 <0.4"
  },
  "devDependencies": {
    "@priemskiyyy/simulcast": "workspace:*"
  },
  "keywords": [
    "partykit",
    "partyserver",
    "partysocket",
    "cloudflare",
    "durable-objects",
    "realtime",
    "websocket",
    "typescript",
    "simulcast",
    "subscriptions"
  ],
  "homepage": "https://priemskiyyy.github.io/simulcast/"
}
