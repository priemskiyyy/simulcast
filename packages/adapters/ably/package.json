{
  "name": "@priemskiyyy/simulcast-ably",
  "version": "0.4.0",
  "description": "Ably adapter for simulcast.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/simulcast.git",
    "directory": "packages/adapters/ably"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/simulcast/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project ably"
  },
  "peerDependencies": {
    "ably": ">=2.0.0 <3",
    "@priemskiyyy/simulcast": ">=0.4.0 <0.5"
  },
  "devDependencies": {
    "@priemskiyyy/simulcast": "workspace:*"
  },
  "keywords": [
    "ably",
    "realtime",
    "websocket",
    "pubsub",
    "typescript",
    "simulcast",
    "subscriptions"
  ],
  "homepage": "https://priemskiyyy.github.io/simulcast/"
}
