{
  "name": "@priemskiyyy/simulcast-phoenix",
  "version": "0.1.0",
  "description": "Phoenix Channels adapter for simulcast.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/simulcast.git",
    "directory": "packages/adapters/phoenix"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/simulcast/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project phoenix"
  },
  "peerDependencies": {
    "phoenix": ">=1.7.0 <2",
    "@priemskiyyy/simulcast": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/simulcast": "workspace:*"
  },
  "keywords": [
    "phoenix",
    "phoenix-channels",
    "elixir",
    "realtime",
    "websocket",
    "pubsub",
    "typescript",
    "simulcast",
    "subscriptions"
  ],
  "homepage": "https://priemskiyyy.github.io/simulcast/"
}
