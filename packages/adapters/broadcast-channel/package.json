{
  "name": "simulcast-broadcast-channel",
  "version": "0.1.0",
  "description": "BroadcastChannel adapter for simulcast: same-origin realtime between tabs, workers, and tests.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/simulcast.git",
    "directory": "packages/adapters/broadcast-channel"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/simulcast/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project broadcast-channel"
  },
  "peerDependencies": {
    "simulcast": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "simulcast": "workspace:*"
  },
  "keywords": [
    "broadcastchannel",
    "tabs",
    "realtime",
    "pubsub",
    "typescript",
    "simulcast",
    "subscriptions"
  ],
  "homepage": "https://priemskiyyy.github.io/simulcast/"
}
