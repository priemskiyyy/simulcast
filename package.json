{
  "name": "simulcast-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './packages/adapters/*' build",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "generate:hooks": "pnpm -r --filter './examples/*' generate:hooks",
    "validate:generated": "pnpm -r --filter './examples/*' validate:generated",
    "check": "pnpm build && pnpm generate:hooks && pnpm lint:typescript && pnpm lint:eslint && pnpm lint:prettier && pnpm test:unit && pnpm test:providers && pnpm validate:generated && pnpm -r --filter './examples/*' build",
    "lint:browser": "tsc --noEmit -p tests/browser && vue-tsc --noEmit -p tests/browser/apps/vue && tsc --noEmit -p tests/browser/apps/solid && svelte-check --tsconfig tests/browser/apps/svelte/tsconfig.json --fail-on-warnings",
    "test:browser": "pnpm build && pnpm lint:browser && playwright test -c tests/browser/playwright.config.ts",
    "build:docs": "vitepress build docs",
    "dev:docs": "vitepress dev docs",
    "test:examples": "pnpm build && pnpm generate:hooks && pnpm -r --filter './examples/*' build && playwright test -c examples/playwright.config.ts",
    "test:providers": "pnpm --filter test-providers test",
    "test:partykit": "pnpm --filter test-partykit test",
    "test:pusher": "pnpm --filter test-pusher test",
    "test:services": "pnpm --filter test-services test",
    "test:integrations": "pnpm test:providers && pnpm test:partykit && pnpm test:pusher && pnpm test:services",
    "verify:docs": "node scripts/verify-docs.mjs",
    "lint:docs": "vue-tsc --noEmit -p docs/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@solidjs/testing-library": "0.8.10",
    "@supabase/realtime-js": "2.116.0",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "22.20.2",
    "@types/phoenix": "1.6.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.0",
    "ably": "2.28.0",
    "centrifuge": "5.7.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.0",
    "jsdom": "27.4.0",
    "mqtt": "5.15.2",
    "partysocket": "1.3.0",
    "phoenix": "1.8.14",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.24",
    "pusher-js": "8.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "4.8.3",
    "solid-js": "1.9.15",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  }
}
